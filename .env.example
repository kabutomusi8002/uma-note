# Optional. Leave both unset to run in the fully local mode.
# These are browser-safe public values from Supabase > Connect / API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy Supabase projects may use the anon key instead of a publishable key.
# Do not set both unless you are testing a key migration.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-key

# Recommended in production so Open Graph URLs use the public origin.
NEXT_PUBLIC_SITE_URL=

# service_role, sb_secret_*, database passwords and connection strings are
# intentionally absent. Use Supabase CLI/dashboard secrets for administration;
# never add those values to NEXT_PUBLIC_* or browser code.
