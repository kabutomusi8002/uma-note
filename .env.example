# Required in the browser. Find both values in Supabase:
# Project settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Recommended in production so Open Graph URLs use the public origin.
NEXT_PUBLIC_SITE_URL=https://your-app.example.com

# Optional, server-side administration or migration only.
# Never expose this value through NEXT_PUBLIC_* or client components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional, only when running PostgreSQL migrations from a local CLI.
# Prefer Supabase's pooled connection string for serverless deployments.
DATABASE_URL=postgresql://postgres.your-project-ref:password@host:6543/postgres
